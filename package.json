{
  "name": "squeektoshi-live",
  "private": true,
  "type": "module",
  "description": "Squeek or Sleep prediction game (squeekorsleep.mfbrat.com) + Squeektoshi Live dashboard (squeek.mfbrat.com)",
  "scripts": {
    "test": "node --test test/",
    "preview:game": "netlify deploy --no-build --site ed7a59a5-9b8a-40ac-89a9-73f1f7c3a4d0",
    "deploy:game": "npm test && netlify deploy --no-build --prod --site ed7a59a5-9b8a-40ac-89a9-73f1f7c3a4d0",
    "preview:dashboard": "cd dashboard && netlify deploy --no-build --site 3e763fc0-a63f-4f12-a5d1-9076e46d6be2 --dir \"$PWD/public\" --functions \"$PWD/no-functions\"",
    "deploy:dashboard": "cd dashboard && netlify deploy --no-build --prod --site 3e763fc0-a63f-4f12-a5d1-9076e46d6be2 --dir \"$PWD/public\" --functions \"$PWD/no-functions\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "viem": "^2.57.13"
  }
}
